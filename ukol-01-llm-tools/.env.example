# =============================================================================
# Varianta A – přímo OpenAI (nejjednodušší)
# =============================================================================
OPENAI_API_KEY=sk-...tvuj-klic...
MODEL=gpt-5.4-nano

# =============================================================================
# Varianta B – přes AI gateway LiteLLM (doporučeno v lekci)
#   1) cd litellm && cp .env.example .env && docker compose up -d
#   2) odkomentuj řádky níže – kód se NEMĚNÍ, jen kam míří OpenAI klient
# =============================================================================
# OPENAI_BASE_URL=http://localhost:4000
# OPENAI_API_KEY=sk-litellm-master-1234     # master key z litellm/.env
# MODEL=gpt-5.4-nano                        # alias z litellm/litellm_config.yaml

# =============================================================================
# Varianta C – lokální model (LM Studio / Unsloth Studio), data neopouští Mac
# =============================================================================
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=none
# MODEL=google/gemma-4-26b-a4b

# Volitelné: ceník pro výpočet ceny běhu (USD za 1 milion tokenů).
# Aktuální ceny: https://openai.com/api/pricing
# PRICE_INPUT_PER_M=0.20
# PRICE_OUTPUT_PER_M=1.25
